{
  "hotkeys": {
    "dictation_toggle": "ctrl+shift+space",
    "meeting_toggle": "ctrl+shift+m",
    "feature_suggest": "ctrl+shift+alt+f"
  },
  "paste_method": "clipboard",
  "language": "en",
  "model": "large-v3",
  "dictation_model": "large-v3",
  "compute_type": "float16",
  "output_dir": "transcriptions",
  "mic_device": null,
  "speaker_device": null,
  "sample_rate": 16000,
  "batch_size": "auto",
  "use_system_devices": true,
  "left_click": "meeting",
  "middle_click": "dictation",
  "auto_sleep_minutes": 30,
  "github_repo": null,
  "github_poll_interval": 120,
  "github_notifications": true,
  "log_window": "normal",
  "device": "auto",
  "incognito": false,
  "always_available_dictation": true,
  "backup_device": "cpu",
  "backup_model": "base",
  "diarize_primary": "balanced_mix",
  "diarize_fallback": "per_channel",
  "diarize_last_resort": "raw_audio",
  "dictation_max_minutes": 30,
  "gpu_guard_single_instance": true,
  "gpu_guard": true,
  "gpu_guard_low_vram_mb": 750,
  "gpu_guard_poll_seconds": 30,
  "gpu_guard_ladder": [
    "large-v3",
    "medium",
    "small",
    "base"
  ],
  "gpu_guard_probe": null,
  "cpu_fallback_model": "base"
}
